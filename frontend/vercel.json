{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*\\.html|robots.txt|sitemap.xml|sw.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "unsafe-none"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://vercel.live https://*.vercel.live https://*.googletagmanager.com https://*.google-analytics.com; script-src-elem 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://vercel.live https://*.vercel.live https://*.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cloudflare.com https://googleapis.com; font-src 'self' https://gstatic.com https://cloudflare.com https://cdn.jsdelivr.net data:; img-src 'self' data: https: https://*.google-analytics.com https://*.googletagmanager.com https://www.google.com; connect-src 'self' https://temp-mail-pro-backend.onrender.com https://tempro.onrender.com https://api.web3forms.com https://cdn.jsdelivr.net wss://*.vercel.live https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://*.g.doubleclick.net; frame-src 'self'; object-src 'none'; base-uri 'self';"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/pst-net-premium-virtual-cards-free-trials-ads",
      "destination": "https://tempmailpk.com/privacy-stack",
      "permanent": true
    },
    {
      "source": "/blog/cashmaal-virtual-visa-cards-online-privacy",
      "destination": "https://tempmailpk.com/privacy-stack",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tempmailpk.vercel.app"
        }
      ],
      "destination": "https://tempmailpk.com/$1",
      "permanent": true
    },
    {
      "destination": "https://tempmailpk.com/$1",
      "has": [
        {
          "type": "host",
          "value": "www.tempmailpk.com"
        }
      ],
      "permanent": true,
      "source": "/(.*)"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tempro-i1it.vercel.app"
        }
      ],
      "destination": "https://tempmailpk.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/privacy-stack",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/registerSW.js",
      "destination": "/registerSW.js"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/rss.xml",
      "destination": "/rss.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/cache-worker.js",
      "destination": "/cache-worker.js"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/dmca",
      "destination": "/index.html"
    },
    {
      "source": "/premium",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|fonts/|images/|icons/|api/|sw\\.js|registerSW\\.js|manifest\\.webmanifest|workbox-.*\\.js|cache-worker\\.js|robots\\.txt|sitemap\\.xml|rss\\.xml|llms\\.txt|pwa-.*|apple-touch-icon\\.png|icon\\.svg|favicon\\.ico).*)",
      "destination": "/api/not-found"
    }
  ]
}